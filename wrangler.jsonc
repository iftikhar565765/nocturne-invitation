{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocturne-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nocturne-invitations",
      "database_id": "e285be7f-347b-4629-95bd-c75409c72a46"
    }
  ]
}
